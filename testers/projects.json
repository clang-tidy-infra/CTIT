{
  "projects": {
    "cppcheck": {
      "url": "https://github.com/danmar/cppcheck.git",
      "commit": "1e79f7ffa1de4b9dc34cd96080f7d78c925d19b0",
      "cmake_flags": ["-DBUILD_TESTS=ON", "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"],
      "build_targets": ["cppcheck-core"]
    },
    "llvm-project": {
      "url": "https://github.com/llvm/llvm-project.git",
      "commit": "c04b00de750801238bc85f11874c66a41b61b2c5",
      "cmake_source_subdir": "llvm",
      "cmake_flags": [
        "-DLLVM_ENABLE_PROJECTS=clang;clang-tools-extra",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON",
        "-DLLVM_ENABLE_ASSERTIONS=ON",
        "-DLLVM_TARGETS_TO_BUILD=X86",
        "-DLLVM_INCLUDE_BENCHMARKS=OFF",
        "-DLLVM_INCLUDE_EXAMPLES=OFF",
        "-DLLVM_INCLUDE_TESTS=OFF",
        "-DCLANG_TIDY_ENABLE_STATIC_ANALYZER=OFF"
      ],
      "build_targets": [
        "clang",
        "clangAnalysisFlowSensitiveResources",
        "clang-nvlink-wrapper",
        "clang-sycl-linker",
        "clang-installapi",
        "clang-scan-deps",
        "clang-linker-wrapper"
      ],
      "file_regex": "clang/(?!.*clang-fuzzer/).*(?<!\\.S)$"
    },
    "doxygen": {
      "url": "https://github.com/doxygen/doxygen.git",
      "commit": "29e1b7ca1171a0026c3e928408877d2cd5c7adca",
      "cmake_flags": [
        "-Dbuild_wizard=OFF",
        "-Dbuild_search=OFF",
        "-Dbuild_doc=OFF",
        "-Duse_libclang=OFF",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ],
      "build_targets": ["generate_configvalues_header"],
      "file_regex": "(?!.*generated_src/).*"
    },
    "poco": {
      "url": "https://github.com/pocoproject/poco.git",
      "commit": "78a5716858c481631bc66048641c1ba884fc509e",
      "cmake_flags": [
        "-DENABLE_TESTS=OFF",
        "-DENABLE_SAMPLES=OFF",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ]
    },
    "abseil-cpp": {
      "url": "https://github.com/abseil/abseil-cpp.git",
      "commit": "64c1b40d732cccd660df378a1639505bbdbfe5b3",
      "cmake_flags": [
        "-DABSL_BUILD_TESTING=OFF",
        "-DABSL_BUILD_TEST_HELPERS=OFF",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ]
    },
    "curl": {
      "url": "https://github.com/curl/curl.git",
      "commit": "aa0be708b9d0c3f147887dbd153d8593294f2717",
      "cmake_flags": [
        "-DBUILD_TESTING=ON",
        "-DCURL_ENABLE_SSL=OFF",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ],
      "build_targets": ["curl"],
      "file_regex": "(?!tests/.*\\.c$).*"
    },
    "stdexec": {
      "url": "https://github.com/NVIDIA/stdexec.git",
      "commit": "0758df65c6571076d67276362c07146e13958740",
      "cmake_flags": [
        "-DSTDEXEC_BUILD_TESTS=ON",
        "-DSTDEXEC_BUILD_EXAMPLES=ON",
        "-DSTDEXEC_BUILD_DOCS=OFF",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ],
      "file_regex": "(?!build/).*"
    },
    "zstd": {
      "url": "https://github.com/facebook/zstd.git",
      "commit": "ee650ef23636145c97ded0440ca743a54362a3ab",
      "cmake_source_subdir": "build/cmake",
      "cmake_flags": [
        "-DZSTD_BUILD_TESTS=OFF",
        "-DZSTD_BUILD_CONTRIB=OFF",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ]
    },
    "libuv": {
      "url": "https://github.com/libuv/libuv.git",
      "commit": "e15526ade343bdfc7cdaaeb0a51b9bba656533ce",
      "cmake_flags": [
        "-DLIBUV_BUILD_TESTS=OFF",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ]
    },
    "libgit2": {
      "url": "https://github.com/libgit2/libgit2.git",
      "commit": "0551dfd4ad989b6a3d5683c0d4cf326c6efef929",
      "cmake_flags": [
        "-DBUILD_TESTS=OFF",
        "-DBUILD_CLI=OFF",
        "-DUSE_HTTPS=OFF",
        "-DUSE_SSH=OFF",
        "-DUSE_NTLMCLIENT=OFF",
        "-DUSE_BUNDLED_ZLIB=ON",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ],
      "file_regex": "(?!deps/).*"
    },
    "catch2": {
      "url": "https://github.com/catchorg/Catch2.git",
      "commit": "02f8b5593a15cdec8558256e6f40a0c7fb5862d6",
      "cmake_flags": [
        "-DCATCH_INSTALL_DOCS=OFF",
        "-DCATCH_INSTALL_EXTRAS=OFF",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ]
    },
    "yaml-cpp": {
      "url": "https://github.com/jbeder/yaml-cpp.git",
      "commit": "8eb618e889c003457d73f7c54777603835677ff4",
      "cmake_flags": [
        "-DYAML_CPP_BUILD_TESTS=OFF",
        "-DYAML_CPP_BUILD_TOOLS=OFF",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ]
    },
    "assimp": {
      "url": "https://github.com/assimp/assimp.git",
      "commit": "747c1d6365ce871ce30897340d97e7cd9b47b9cc",
      "cmake_flags": [
        "-DASSIMP_BUILD_TESTS=OFF",
        "-DASSIMP_BUILD_ASSIMP_TOOLS=OFF",
        "-DASSIMP_BUILD_ZLIB=ON",
        "-DASSIMP_INSTALL=OFF",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
      ],
      "file_regex": "(?!contrib/).*"
    }
  }
}
