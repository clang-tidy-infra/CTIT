# Copy to .env on the VM and fill in. Never commit .env.

# Public DNS that resolves to this VM (A/AAAA record). Traefik obtains a
# Let's Encrypt certificate for this name automatically.
CODECHECKER_DOMAIN=codechecker.example.com

# Email used by Traefik for Let's Encrypt account / renewal notices.
# Required by the ACME spec, so this can't be empty.
TRAEFIK_ACME_EMAIL=ops@example.com

# Postgres credentials for the codechecker database. Pick a strong password;
# this is shared between the postgres service and the CodeChecker server.
POSTGRES_PASSWORD=change-me-strong-random-string

# Initial superuser created on first server boot. Used to log into the web UI
# and to issue API tokens for the GitHub Actions runner.
CODECHECKER_SUPERUSER=admin
CODECHECKER_SUPERUSER_PASSWORD=change-me-strong-random-string
